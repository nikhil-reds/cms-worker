# Node Environment
NODE_ENV=development

# Worker Role
# Options: all, analytics, notifications, scheduler, manifest, media
WORKER_ROLE=all

# ============================================================================
# PostgreSQL - Main Application Database
# ============================================================================
DATABASE_URL=postgresql://rubenius_user:rubenius_password@postgres:5432/rubenius

# ============================================================================
# TimescaleDB - Analytics Database
# ============================================================================
ANALYTICS_DATABASE_URL=postgresql://analytics_user:analytics_password@timescaledb:5433/analytics

# ============================================================================
# Redis - BullMQ Queue Storage
# ============================================================================
REDIS_URL=redis://redis:6379

# ============================================================================
# RabbitMQ - Message Broker
# ============================================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_NOTIFICATION_EXCHANGE=notifications
RABBITMQ_NOTIFICATION_QUEUE=notification-queue
RABBITMQ_NOTIFICATION_DLX=notification-dlx
RABBITMQ_TELEMETRY_EXCHANGE=telemetry
RABBITMQ_TELEMETRY_QUEUE=telemetry-queue
RABBITMQ_TELEMETRY_DLX=telemetry-dlx
RABBITMQ_ENABLED=true
RABBITMQ_SCHEDULER_EVALUATE_QUEUE=scheduler.evaluate.now
RABBITMQ_SCHEDULER_RETRY_QUEUE=scheduler.evaluate.retry
RABBITMQ_SCHEDULER_DLQ=scheduler.evaluate.dead_letter
RABBITMQ_SCHEDULER_PREFETCH=5
RABBITMQ_SCHEDULER_MAX_RETRIES=3
RABBITMQ_SCHEDULER_RETRY_DELAY_MS=10000
RABBITMQ_SCHEDULER_METRICS_INTERVAL_MS=30000

# ============================================================================
# Kafka / Redpanda - Event Streaming (Optional, for high-volume telemetry)
# ============================================================================
KAFKA_BROKERS=redpanda:29092
KAFKA_CLIENT_ID=cms-worker
KAFKA_TELEMETRY_TOPIC=telemetry
KAFKA_CONSUMER_GROUP=cms-worker-analytics
KAFKA_NOTIFICATIONS_TOPIC=notifications
REDPANDA_ENABLED=true
REDPANDA_BROKERS=redpanda:9092
REDPANDA_CLIENT_ID=cms-worker-scheduler
REDPANDA_SCHEDULER_EVALUATION_TOPIC=scheduler.evaluation.completed
REDPANDA_PLAYER_MANIFEST_PUBLISHED_TOPIC=player.manifest.published
REDPANDA_PLAYER_UPDATE_FAILED_TOPIC=player.update.failed
REDPANDA_DEBUG_CONSUMER_ENABLED=false
REDPANDA_SCHEDULER_DEBUG_CONSUMER_GROUP=cms-worker-scheduler-debug
PLAYER_WS_ENABLED=true
PLAYER_WS_PORT=3001
PLAYER_WS_PATH=/ws/player
PLAYER_WS_TOKEN=change-me
PLAYER_WS_HEARTBEAT_MS=30000

# ============================================================================
# AWS S3 - Media and Manifest Storage
# For local development with LocalStack:
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT=http://localstack:4566
S3_BUCKET=rubenius-media

# ============================================================================
# AWS CloudFront - CDN and Cache Invalidation
# ============================================================================
CLOUDFRONT_DISTRIBUTION_ID=E1234ABCD5678
CLOUDFRONT_ENABLE_INVALIDATION=true
PLAYER_CDN_URL=https://d111111abcdef8.cloudfront.net
NEXT_PUBLIC_CDN_URL=https://d111111abcdef8.cloudfront.net

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=debug

# ============================================================================
# Media Sync Worker - File Transfer Configuration
# ============================================================================
WORKER_ROLE=media-sync
PLAYER_MEDIA_ROOT_PATH=/path/to/Player/media
MEDIA_SYNC_STRATEGY=polling
MEDIA_SYNC_INTERVAL_MS=30000
MEDIA_SYNC_CONCURRENCY=5
MEDIA_ENABLE_CHECKSUM_VALIDATION=true
MEDIA_MAX_DISK_USAGE_PERCENT=80
MEDIA_CLEANUP_ORPHANED_FILES=false

# ============================================================================
# Playlist Render Worker - Playlist → single MP4 for the Player
# ============================================================================
# Bucket where the CMS writes playlists/{id}.json on playlist create/update
AWS_BUCKET_PLAYLIST=redsxp-playlist
# Bucket where the worker uploads the rendered playlist MP4s
AWS_BUCKET_MEDIA_PROCESSED=redsxp-media-processed
# Legacy alias supported by the worker if older env files use it
# AWS_BUCKET_PROCESSED=redsxp-media-processed
PLAYLIST_RENDER_INTERVAL_MS=30000
PLAYLIST_RENDER_RESOLUTION=1920x1080
PLAYLIST_RENDER_FPS=30
# append: rendered video joins existing player playlist entries
# exclusive: rendered video replaces the whole player playlist
PLAYLIST_RENDER_MODE=append
# natural: a source video shorter than its item duration plays once
# loop: it loops until the item duration is filled
PLAYLIST_RENDER_SHORT_VIDEO=natural
PLAYLIST_RENDER_SCRATCH_DIR=/tmp/cms-worker/renders
# Optional overrides for the bundled ffmpeg/ffprobe binaries
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# ============================================================================
# Optional: Notification Providers
# ============================================================================
# Email (SendGrid, AWS SES, etc.)
# SENDGRID_API_KEY=
# AWS_SES_REGION=us-east-1

# Slack
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=

# Webhook
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_MAX_RETRIES=3
